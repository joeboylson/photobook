# Copy to .env.local for local development.
PHOTOBOOK_BUCKET=photobook-537987987943
PHOTOBOOK_AWS_REGION=us-east-2
# Locally the AWS SDK signs in with this profile (run `aws login --profile photobook` first).
AWS_PROFILE=photobook
# On Vercel only: the bucket-only key for the photobook-vercel AWS user.
# PHOTOBOOK_AWS_ACCESS_KEY_ID=
# PHOTOBOOK_AWS_SECRET_ACCESS_KEY=
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to edit.
EDITOR_EMAILS=
# Local only: Sign in skips Google and signs you in as the first EDITOR_EMAILS entry. Ignored on Vercel.
# SKIP_EDITOR_SIGN_IN=true
